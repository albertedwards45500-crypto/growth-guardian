# Copying is optional: init_env.py generates .env without printing credentials.
PUBLIC_ORIGIN=http://YOUR_SERVER_IP
HTTP_BIND=0.0.0.0
HTTP_PORT=80
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
SECRET_KEY=REPLACE_WITH_RANDOM_HEX_AT_LEAST_64_CHARACTERS
# Optional registry overrides; use a registry you trust and can reach.
MYSQL_IMAGE=mysql:8.0
PYTHON_IMAGE=python:3.12-slim
NGINX_IMAGE=nginx:1.28-alpine
