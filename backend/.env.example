# 后端环境变量示例（复制为 .env 后按实际环境修改）
# 安全要求：生产环境凭据必须通过环境变量注入，禁止将真实口令/密钥写入仓库

# ---- 应用 ----
# 应用名称
APP_NAME=宝宝辅食与成长记录 - 后端服务
# 调试开关：true 为开发模式（跳过生产配置强校验）；生产环境必须为 false
DEBUG=false

# ---- 数据库（MySQL）----
# 数据库连接串：请使用独立业务账号（禁止 root），并将口令替换为强密码
# 生产环境必须通过环境变量注入真实值，禁止写入仓库
DATABASE_URL=mysql+pymysql://baby_user:<your-db-password>@127.0.0.1:3306/baby_growth?charset=utf8mb4

# ---- JWT 安全 ----
# 令牌签名密钥：生产环境必须替换为随机生成的强密钥（不少于 32 字符），禁止入库
SECRET_KEY=please-generate-a-random-64-char-secret-key-here
# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---- CORS ----
# 允许的前端来源，逗号分隔；生产环境应替换为正式域名
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 日志 ----
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- 可选：LangGraph 只读智能体与 RAG ----
# 开启后会将提问、月龄及最小化记录摘要发送至配置的模型服务。
ADVISOR_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 填写该服务支持 Responses + function calling + Structured Outputs 的模型 ID
ADVISOR_MODEL=
ADVISOR_MODEL_TIMEOUT_SECONDS=20
ADVISOR_AGENT_MAX_ROUNDS=3
ADVISOR_AGENT_MAX_TOOL_CALLS=6
RAG_ENABLED=false
# Embedding 使用独立服务配置，不会复用问答密钥
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
# OpenAI可配置维度模型为true；BAAI/bge-m3等固定维度模型设为false
RAG_EMBEDDING_SEND_DIMENSIONS=true
RAG_TOP_K=3
RAG_MIN_SCORE=0.55
# QDRANT_PATH 不设置时使用 backend/data/qdrant；本地模式只支持单进程。
# 多进程/多实例部署应填写独立 Qdrant 服务 URL；集合只放公开审核知识。
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=reviewed_baby_knowledge_v1
